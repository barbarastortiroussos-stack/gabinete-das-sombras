---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const contos = (await getCollection('contos', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf()).slice(0, 5);
---
<Base>
  <h1>Contos para ler com a luz baixa</h1>
  <p class="intro">Histórias sombrias, românticas e estranhas, escritas no espírito dos antigos contos de fadas.</p>
  <h2>Últimas gavetas abertas</h2>
  <ul class="gavetas">
    {contos.map((c) => (
      <li class="gaveta"><a href={`/contos/${c.id}/`}>
        <span class="puxador" aria-hidden="true"></span>
        <div><div class="nota">{c.data.categoria}</div><h3>{c.data.titulo}</h3><p>{c.data.resumo}</p></div>
      </a></li>
    ))}
  </ul>
</Base>
